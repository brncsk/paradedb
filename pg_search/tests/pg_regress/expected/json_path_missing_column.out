-- An outer join with a predicate the scan can't push down.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT count(*), ju.metadata->'brand'
FROM ju FULL JOIN jp ON ju.id = jp.id
WHERE (ju.name @@@ 'bob') OR ((ju.name IS NULL) AND (ju.name @@@ 'bob'))
GROUP BY ju.metadata->'brand'
ORDER BY 2;
WARNING:  Aggregate Scan not used: grouping field metadata.brand is a JSON value, which is grouped by Postgres. To disable this warning: SET paradedb.planner_warnings = 'off' (table: ju)
                                                                       QUERY PLAN                                                                        
---------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: count(*), ((ju.metadata -> 'brand'::text))
   Group Key: ((ju.metadata -> 'brand'::text))
   ->  Sort
         Output: ((ju.metadata -> 'brand'::text))
         Sort Key: ((ju.metadata -> 'brand'::text))
         ->  Custom Scan (ParadeDB Base Scan) on public.ju
               Output: (ju.metadata -> 'brand'::text)
               Table: ju
               Index: ju_idx
               Worker Selection: Cost model
               Exec Method: NormalScanExecState
               Scores: false
               Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"bob","lenient":null,"conjunction_mode":null}}}}
(14 rows)

SELECT count(*), ju.metadata->'brand'
FROM ju FULL JOIN jp ON ju.id = jp.id
WHERE (ju.name @@@ 'bob') OR ((ju.name IS NULL) AND (ju.name @@@ 'bob'))
GROUP BY ju.metadata->'brand'
ORDER BY 2;
WARNING:  Aggregate Scan not used: grouping field metadata.brand is a JSON value, which is grouped by Postgres. To disable this warning: SET paradedb.planner_warnings = 'off' (table: ju)
 count | ?column? 
-------+----------
    20 | "apple"
     2 | 
(2 rows)

-- A right join null-extends a `jp` row with no `ju` match, so the NULL group mixes a
-- null-extended row with the two rows whose segment has no column.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT ju.metadata->>'brand', count(jp.id)
FROM ju RIGHT JOIN jp ON ju.id = jp.id
WHERE jp.name IS NOT NULL
GROUP BY 1
ORDER BY 1;
WARNING:  Aggregate Scan (DataFusion) not used: GROUP BY column metadata.brand is a JSON value, which is grouped by Postgres (table: join)
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Output: ((ju.metadata ->> 'brand'::text)), (count(jp.id))
   Sort Key: ((ju.metadata ->> 'brand'::text))
   ->  HashAggregate
         Output: ((ju.metadata ->> 'brand'::text)), count(jp.id)
         Group Key: (ju.metadata ->> 'brand'::text)
         ->  Hash Left Join
               Output: (ju.metadata ->> 'brand'::text), jp.id
               Inner Unique: true
               Hash Cond: (jp.id = ju.id)
               ->  Seq Scan on public.jp
                     Output: jp.id, jp.name
                     Filter: (jp.name IS NOT NULL)
               ->  Hash
                     Output: ju.metadata, ju.id
                     ->  Seq Scan on public.ju
                           Output: ju.metadata, ju.id
(17 rows)

SELECT ju.metadata->>'brand', count(jp.id)
FROM ju RIGHT JOIN jp ON ju.id = jp.id
WHERE jp.name IS NOT NULL
GROUP BY 1
ORDER BY 1;
WARNING:  Aggregate Scan (DataFusion) not used: GROUP BY column metadata.brand is a JSON value, which is grouped by Postgres (table: join)
 ?column? | count 
----------+-------
 apple    |    20
          |     3
(2 rows)

-- The same queries without the custom scans, as the reference.
SET paradedb.enable_custom_scan TO false;
SET paradedb.enable_join_custom_scan TO false;
SET paradedb.enable_aggregate_custom_scan TO false;
SELECT ju.metadata->>'brand', count(*)
FROM ju JOIN jp ON ju.id = jp.id
WHERE ju.name IS NOT NULL
GROUP BY 1
ORDER BY 1;
 ?column? | count 
----------+-------
 apple    |    20
          |     2
(2 rows)

