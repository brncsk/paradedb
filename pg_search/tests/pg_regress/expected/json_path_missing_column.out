DROP TABLE jp;
DROP TABLE ju;
RESET paradedb.enable_aggregate_custom_scan;
RESET paradedb.enable_join_custom_scan;
RESET paradedb.enable_custom_scan_without_operator;
RESET paradedb.enable_custom_scan;
