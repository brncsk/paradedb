SELECT count(*), ju.metadata->'brand'
FROM ju FULL JOIN jp ON ju.id = jp.id
WHERE (ju.name = 'bob') OR ((ju.name IS NULL) AND (ju.name = 'bob'))
GROUP BY ju.metadata->'brand'
ORDER BY 2;
 count | ?column? 
-------+----------
