-- Without the bitmap intersection no index covers the clause for the
-- search, and the DataFusion scans take the join, with the same answers.
SET paradedb.enable_bitmap_intersection = off;
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT count(*)
FROM covered_places p
JOIN covered_shapes s ON s.place_id = p.id
WHERE p.name ||| 'place'
  AND p.location <@ box '((10,10),(12,12))'
  AND s.kind ||| 'footprint';
                                                                                                                                                                                                  QUERY PLAN                                                                                                                                                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: covered_places_idx (p), covered_shapes_idx (s)
   Aggregates: COUNT(*)
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[count(1) as agg_0]
     :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(place_id@0, id@0)], projection=[]
     :     CooperativeExec
     :       PgSearchScan: table=s, segments=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"kind","value":"footprint","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     CooperativeExec
     :       PgSearchScan: table=p, segments=1, dynamic_filters=1, visibility=eager, query={"boolean":{"must":[{"with_index":{"query":{"match":{"field":"name","value":"place","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(location <@ '(12,12),(10,10)'::box)"}]}}]}}
(11 rows)

SELECT count(*)
FROM covered_places p
JOIN covered_shapes s ON s.place_id = p.id
WHERE p.name ||| 'place'
  AND p.location <@ box '((10,10),(12,12))'
  AND s.kind ||| 'footprint';
